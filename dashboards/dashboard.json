  "description": "Dashboard JJ Eletronicos: Infra, HTTP, Negocio, Estoque e Logs",
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": " INFRAESTRUTURA",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
